{
  "name": "dsh-gpt-free-relay",
  "version": "2.0.0-beta",
  "description": "DSH 插件。解析机场订阅，在本机起一个串行反向代理，让 DSH 的模型请求走你的线路。并发固定为 1，不传工具调用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "license": "MIT",
  "author": "dsh-gpt-free-relay contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxxk11454-cmyk/dsh-gpt-free-relay.git"
  },
  "homepage": "https://github.com/fxxk11454-cmyk/dsh-gpt-free-relay#readme",
  "bugs": {
    "url": "https://github.com/fxxk11454-cmyk/dsh-gpt-free-relay/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "AGENTS.md",
    "README.md",
    "setup.sh",
    "setup.bat"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale",
        "settingsScope"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "relay",
    "proxy",
    "subscription"
  ],
  "publishConfig": {
    "access": "public"
  }
}
